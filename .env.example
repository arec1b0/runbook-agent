# LLM provider: "openai" (default) or "anthropic"
LLM_PROVIDER=openai

# Model identifier for the selected provider
# openai examples: gpt-4o, gpt-4o-mini
# anthropic examples: claude-sonnet-4-6
LLM_MODEL=gpt-4o

# API key — only the variable matching LLM_PROVIDER is required
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: an OpenAI-compatible endpoint instead of api.openai.com, e.g. local Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# Structured outputs (json_schema) for the triage decision; needed for Ollama, which ignores
# tool_choice: "true" or "false" (default)
# LLM_STRUCTURED_OUTPUTS=false

# Optional TraceBlame tracing (traceblame-ts installed): "1" to enable. Export goes to
# OTEL_EXPORTER_OTLP_ENDPOINT; no prompt, output or tool argument is recorded.
# TRACEBLAME_ENABLED=0

# HTTP server port for Alertmanager webhook ingestion
PORT=3000

# Execution mode: "dry-run" (default, no real actions) or "live"
EXECUTION_MODE=dry-run

# Minimum log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Approval timeout in milliseconds (default: 300000 = 5 minutes)
# Unanswered approvals are denied after this period.
APPROVAL_TIMEOUT_MS=300000

# Path to the JSONL incident history file
INCIDENT_FILE_PATH=data/incidents.jsonl